@page "/results/{GameId:guid}"
@inject HttpClient Http
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudText Typo="Typo.h3" Align="Align.Center" GutterBottom="true">Game Results</MudText>

    @if (_isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mx-auto" Style="display:block;" />
    }
    else if (_errorMessage != null)
    {
        <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
    }
    else if (_results != null)
    {
        @if (_results.Leaderboard.Any())
        {
            var winner = _results.Leaderboard.First();
            <MudPaper Class="pa-4 mb-8 d-flex flex-column align-center" Elevation="3">
                <MudText Typo="Typo.h4" Color="Color.Success">Winner: @winner.UserName 🏆</MudText>
                <MudText Typo="Typo.h5">Score: @winner.Score</MudText>
            </MudPaper>

            <MudTable Items="_results.Leaderboard" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="1">
                <HeaderContent>
                    <MudTh>Rank</MudTh>
                    <MudTh>Player</MudTh>
                    <MudTh>Points</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Rank">@(_results.Leaderboard.IndexOf(context) + 1)</MudTd>
                    <MudTd DataLabel="Player">@context.UserName</MudTd>
                    <MudTd DataLabel="Points">@context.Score</MudTd>
                </RowTemplate>
            </MudTable>
        }
        else if (!_chains.Any())
        {
            <MudAlert Severity="Severity.Info">No results available for this game.</MudAlert>
        }

        @foreach (var chain in _chains)
        {
            <MudPaper Class="pa-4 mb-4" Elevation="2">
                <MudText Typo="Typo.h6" GutterBottom="true">@chain.Owner's chain: started with <b>@chain.OriginalFlag</b></MudText>
                @foreach (var step in chain.Steps)
                {
                    <div class="mb-3">
                        <MudText Typo="Typo.caption">@step.Player @(step.Type == "draw" ? "drew" : "guessed")</MudText>
                        @if (string.IsNullOrEmpty(step.Content))
                        {
                            <MudText Typo="Typo.body2"><i>(nothing submitted)</i></MudText>
                        }
                        else if (step.Type == "draw")
                        {
                            <img src="/api/drawings/@step.Content" alt="Drawing by @step.Player" width="400" height="300" style="border: 1px solid black; display: block;" />
                        }
                        else
                        {
                            <MudText Typo="Typo.h6">@step.Content</MudText>
                        }
                    </div>
                }
            </MudPaper>
        }

        <div Class="d-flex gap-4 mt-6">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GoBackToLobby">Go back to lobby</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="GoHome">Back to Home</MudButton>
        </div>
    }
</MudContainer>

@code {
    [Parameter]
    public Guid GameId { get; set; }

    private bool _isLoading = true;
    private string? _errorMessage;
    private GameResultsDto? _results;
    private List<ChainDto> _chains = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _results = await Http.GetFromJsonAsync<GameResultsDto>($"/api/games/{GameId}/results");
            _chains = await Http.GetFromJsonAsync<List<ChainDto>>($"/api/games/{GameId}/chains") ?? new();
            if (_results == null)
            {
                _errorMessage = "Failed to load results.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "An error occurred while loading results.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void GoHome()
    {
        Nav.NavigateTo("/");
    }

    private void GoBackToLobby()
    {
        if (_results != null)
        {
            Nav.NavigateTo($"/lobby/{_results.LobbyId}");
        }
    }

    public class GameResultsDto
    {
        public Guid GameId { get; set; }
        public Guid LobbyId { get; set; }
        public List<PlayerScoreDto> Leaderboard { get; set; } = new();
    }

    public class ChainDto
    {
        public string Owner { get; set; } = "";
        public string OriginalFlag { get; set; } = "";
        public List<ChainStepDto> Steps { get; set; } = new();
    }

    public class ChainStepDto
    {
        public string Player { get; set; } = "";
        public string Type { get; set; } = "";
        public string? Content { get; set; }
    }

    public class PlayerScoreDto
    {
        public string UserId { get; set; } = "";
        public string UserName { get; set; } = "";
        public int Score { get; set; }
    }
}

